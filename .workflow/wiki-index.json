    {
      "id": "knowhow-RCP-20260920-github-actions-tauri-001",
      "type": "knowhow",
      "title": "Goal",
      "summary": "为 Tauri 桌面应用建立可重复的 GitHub 构建、校验与发布流程，并让发布产物进入 draft GitHub Release 供人工复核。",
      "tags": [
