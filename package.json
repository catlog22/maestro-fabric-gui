{
  "name": "maestro-fabric-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421",
    "dev:tauri": "npm run build:bridge && vite --host 127.0.0.1 --port 1421",
    "build": "npm run build:bridge && tsc -b && vite build",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-release-version.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p bridge/tsconfig.json --noEmit",
    "test": "vitest run && npm run test:bridge",
    "test:ui": "vitest run",
    "test:bridge": "npm run build:bridge && node --test bridge/test/*.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
